openapi: 3.0.1

info:
  title: VirusTotal File Hash Threat Intelligence
  description: >
    Enriches a file hash with a scoped VirusTotal API v3 file report. The
    operation uses VirusTotal's fields query parameter to avoid returning large
    objects such as last_analysis_results, PE sections, imports, and full name
    lists.
  version: 1.0.1

servers:
  - url: https://www.virustotal.com/api/v3
    description: VirusTotal API v3

security:
  - VTApiKey: []

components:
  securitySchemes:
    VTApiKey:
      type: apiKey
      in: header
      name: x-apikey
      description: VirusTotal API key. Use the raw x-apikey header value with no Bearer prefix.

  schemas:
    LastAnalysisStats:
      type: object
      properties:
        malicious:
          type: integer
        suspicious:
          type: integer
        undetected:
          type: integer
        harmless:
          type: integer
        timeout:
          type: integer
        type-unsupported:
          type: integer

    TotalVotes:
      type: object
      properties:
        harmless:
          type: integer
        malicious:
          type: integer

    PopularThreatClassification:
      type: object
      properties:
        suggested_threat_label:
          type: string
        popular_threat_category:
          type: array
          items:
            type: object
            properties:
              count:
                type: integer
              value:
                type: string
        popular_threat_name:
          type: array
          items:
            type: object
            properties:
              count:
                type: integer
              value:
                type: string

    VirusTotalFileReport:
      type: object
      additionalProperties: true
      properties:
        data:
          type: object
          additionalProperties: true
          properties:
            id:
              type: string
              description: Canonical SHA-256 VirusTotal file object ID.
            type:
              type: string
            attributes:
              type: object
              additionalProperties: true
              properties:
                last_analysis_stats:
                  $ref: '#/components/schemas/LastAnalysisStats'
                reputation:
                  type: integer
                total_votes:
                  $ref: '#/components/schemas/TotalVotes'
                popular_threat_classification:
                  $ref: '#/components/schemas/PopularThreatClassification'
                sandbox_verdicts:
                  type: object
                  additionalProperties: true
                meaningful_name:
                  type: string
                names:
                  type: array
                  items:
                    type: string
                type_description:
                  type: string
                type_tag:
                  type: string
                magic:
                  type: string
                size:
                  type: integer
                signature_info:
                  type: object
                  additionalProperties: true
                exiftool:
                  type: object
                  additionalProperties: true
                pe_info:
                  type: object
                  additionalProperties: true
                first_submission_date:
                  type: integer
                last_analysis_date:
                  type: integer
        error:
          type: object
          additionalProperties: true
          properties:
            code:
              type: string
            message:
              type: string

paths:
  /files/{id}:
    get:
      operationId: GetFileReport
      summary: Get a scoped VirusTotal file report for a file hash
      description: |
        Retrieves a scoped VirusTotal file report for an MD5, SHA-1, or SHA-256
        hash. Always send the `fields` query parameter so VirusTotal returns
        only the fields needed for the analyst report and excludes high-volume
        fields such as `last_analysis_results`.

        The default `fields` value intentionally includes only:
        id, type, aggregate detection stats, reputation and votes, popular
        threat classification, sandbox verdicts, one or two names, concise file
        metadata, signature/resource metadata, first submission date, and last
        analysis date.
      parameters:
        - name: id
          in: path
          required: true
          description: >
            File hash to look up. Accepts MD5 (32 hex chars), SHA-1 (40 hex
            chars), or SHA-256 (64 hex chars). Pass the raw hex string with no
            prefix and no quotes.
          schema:
            type: string
          example: 44d88612fea8a8f36de82e1278abb02f
        - name: fields
          in: query
          required: false
          description: >
            VirusTotal partial response field selector. Use the default value
            exactly as provided to avoid large responses and agent timeouts.
          schema:
            type: string
            default: data.id,data.type,data.attributes.last_analysis_stats,data.attributes.reputation,data.attributes.total_votes,data.attributes.popular_threat_classification,data.attributes.sandbox_verdicts,data.attributes.meaningful_name,data.attributes.names,data.attributes.type_description,data.attributes.type_tag,data.attributes.magic,data.attributes.size,data.attributes.signature_info,data.attributes.exiftool,data.attributes.pe_info.resource_details,data.attributes.first_submission_date,data.attributes.last_analysis_date
          example: data.id,data.type,data.attributes.last_analysis_stats,data.attributes.reputation,data.attributes.total_votes,data.attributes.popular_threat_classification,data.attributes.sandbox_verdicts,data.attributes.meaningful_name,data.attributes.names,data.attributes.type_description,data.attributes.type_tag,data.attributes.magic,data.attributes.size,data.attributes.signature_info,data.attributes.exiftool,data.attributes.pe_info.resource_details,data.attributes.first_submission_date,data.attributes.last_analysis_date
      responses:
        '200':
          description: Scoped VirusTotal report for the file hash.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/VirusTotalFileReport'
        '400':
          description: Bad request. The hash is malformed or the fields parameter is invalid.
        '401':
          description: Unauthorized. The x-apikey value is invalid or missing.
        '404':
          description: Not found. VirusTotal has no record of this hash.
        '429':
          description: Quota exceeded or rate limited.
